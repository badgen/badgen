{
  "compilerOptions": {
    "strict": true,

    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM"],

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": false,
    "declaration": true,
    "noEmitOnError": true,

    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
